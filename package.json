{
  "name": "citro-eighty",
  "type": "module",
  "scripts": {
    "start": "bin/server index",
    "start:worker": "bin/server worker",
    "manage": "bin/server manage",
    "build": "pnpm run build:tsc && pnpm run build:client && pnpm build:server",
    "build:tsc": "tsc",
    "build:client": "NODE_ENV=production vite build --outDir dist/client",
    "build:server": "NODE_ENV=production vite build --outDir dist/server --ssr src/entry-server.tsx",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "test": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test vitest",
    "generate-types": "bin/server manage generate-db && pnpm run lint --fix && pnpm run format"
  },
  "dependencies": {
    "@devmoods/config": "^0.2.4",
    "@devmoods/express-extras": "^0.74.0",
    "@devmoods/fetch": "^4.3.0",
    "@devmoods/postgres-admin": "^0.18.1",
    "@devmoods/sentry": "^0.3.0",
    "@devmoods/ui": "^2.16.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "arktype": "2.2.0",
    "dotenv": "^17.4.2",
    "express": "4.22.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.1"
  },
  "devDependencies": {
    "@devmoods/oxc": "^0.2.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
