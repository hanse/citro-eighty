{
  "name": "citro-eighty",
  "type": "module",
  "scripts": {
    "start": "bin/server index",
    "start:worker": "bin/server worker",
    "manage": "bin/server manage",
    "build": "pnpm run build:tsc && pnpm run build:client && pnpm build:server",
    "build:tsc": "tsc",
    "build:client": "NODE_ENV=production vite build --outDir dist/client",
    "build:server": "NODE_ENV=production vite build --outDir dist/server --ssr src/entry-server.tsx",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "test": "NODE_ENV=test DOTENV_CONFIG_PATH=.env.test vitest",
    "generate-types": "bin/server manage generate-db && pnpm run lint --fix && pnpm run format"
  },
  "dependencies": {
    "@devmoods/config": "^0.3.0",
    "@devmoods/express-extras": "^0.77.1",
    "@devmoods/fetch": "^4.3.1",
    "@devmoods/postgres-admin": "^0.21.1",
    "@devmoods/sentry": "^0.6.1",
    "@devmoods/ui": "^2.20.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "arktype": "2.2.9",
    "dotenv": "^18.0.9",
    "express": "4.22.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@devmoods/oxc": "^0.4.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
